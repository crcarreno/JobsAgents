# Application
# Use "development" only for local HTTP work; production enables secure cookies.
APP_ENVIRONMENT=production
APP_SECRET_KEY=replace-with-64-random-hex-characters
FLASK_SECRET_KEY=
APP_TIMEZONE=America/Guayaquil

# MySQL (PyMySQL driver)
DATABASE_URL=mysql+pymysql://jobagents:change-me@127.0.0.1:3306/jobagents?charset=utf8mb4
# Optional test database used by pytest; defaults to DATABASE_URL with a _test suffix.
# TEST_DATABASE_URL=mysql+pymysql://jobagents:change-me@127.0.0.1:3306/jobagents_test?charset=utf8mb4

# OpenCode Go inference API
AI_PROVIDER=opencode_go
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Agent
JOBAGENTS_AGENT_MODE=observation
JOBAGENTS_AGENT_ENABLED=true
JOBAGENTS_AGENT_SCAN_INTERVAL_MINUTES=30

# Budgets
JOBAGENTS_BUDGET_DAILY_LIMIT_USD=0.50
JOBAGENTS_BUDGET_MONTHLY_LIMIT_USD=10.00

# GitHub token used by the GitHub bounty adapter (repo scope for PR delivery)
GITHUB_TOKEN=

# OpenTask API token (scopes: profile:read, tasks:read, capabilities:read)
OPENTASK_API_TOKEN=

# Worker / logging
LOG_LEVEL=INFO
LOG_DIR=/var/log/jobagents
